{
  "name": "@pulse-live/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite dev --config dev/vite.config.ts",
    "lint": "eslint src dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pulse-live/overlays": "workspace:*",
    "@pulse-live/presets": "workspace:*",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
